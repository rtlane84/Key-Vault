# Database
# Use your Supabase connection string
DATABASE_URL=postgresql://postgres:[password]@db.[id].supabase.co:5432/postgres

# Authentication
# Run `openssl rand -base64 32` to generate a secure secret
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_immediately

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLIENT_ID=ca_... # Required for Stripe Connect OAuth

# Email (Resend)
# If RESEND_API_KEY is not set, the system will simulate emails in the logs
RESEND_API_KEY=re_...
FROM_EMAIL=delivery@yourdomain.com
APP_NAME="Key Sender"

# eBay
# Get these from the eBay Developer Portal
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_cert_id
EBAY_REDIRECT_URI=https://your-api.com/api/ebay/callback

# Server Configuration
# API Port (Railway provides this automatically)
PORT=3000

# App URLs
# APP_URL/NEXT_PUBLIC_APP_URL should point to your dashboard URL
APP_URL=https://your-dashboard.com
NEXT_PUBLIC_APP_URL=https://your-dashboard.com

# VITE_API_URL should point to your API server's /api endpoint
VITE_API_URL=https://your-api.com/api

# Logging
# info, warn, error
LOG_LEVEL=info
