# Database
DATABASE_URL=postgresql://user:password@localhost:5432/keyvault

# Authentication
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=delivery@yourdomain.com
APP_NAME=Key Delivery

# eBay
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_REDIRECT_URI=https://your-api.com/api/ebay/callback

# App URLs
APP_URL=https://your-dashboard.com
NEXT_PUBLIC_APP_URL=https://your-dashboard.com
VITE_API_URL=https://your-api.com/api

# Logging (Optional)
LOG_LEVEL=info
