# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Admin Auth ───────────────────────────────────────────────────────────────
# JWT secret — use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin credentials for dashboard login
ADMIN_EMAIL=admin@yourdomain.com
# Plaintext for dev; bcrypt hash ($2b$...) recommended for production
ADMIN_PASSWORD=change-me

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get from https://dashboard.stripe.com/webhooks after adding endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified sender domain in Resend
FROM_EMAIL=delivery@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL for redirect URLs in Stripe checkout sessions
APP_URL=https://yourdomain.com
APP_NAME=KeyVault

# ── eBay (optional) ──────────────────────────────────────────────────────────
# Only needed for real eBay sync. Without these, app runs in mock mode.
# Get from https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Must match the redirect URI configured in your eBay developer app
EBAY_REDIRECT_URI=https://yourdomain.com/api/ebay/callback
